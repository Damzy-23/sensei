# Copy to .env and fill in. Never commit .env.

# --- Anthropic (reasoning / fast models) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_REASONING=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# --- Hint model: base (Anthropic reasoning model) or tuned (OpenAI-compatible endpoint) ---
HINT_MODEL=base
HINT_TUNED_BASE_URL=
HINT_TUNED_API_KEY=
HINT_TUNED_MODEL=

# --- Runtime ---
SENSEI_DB_PATH=data/sensei.db
# 1 = serve fixed sample data (no key needed). 0 = run the real agents.
SENSEI_USE_STUBS=1
DEMO_MODE=0
# Firestore database that keeps sessions, chats and mentor tickets across restarts. Empty: SENSEI_LOG_FIRESTORE_DB if set, else off.
SENSEI_STATE_FIRESTORE_DB=

# --- Who can see what (docs/API.md, "Who can see what") ---
# 1 = a visitor sees only the sessions their own browser started, and mentors see every session.
# Empty = every caller sees every session. Fine on your own machine; set it to 1 on a public server.
SENSEI_SCOPE_DATA=
# Mentors, comma separated. A mentor is a signed-in user whose verified email is on this list.
SENSEI_MENTOR_EMAILS=
# The Firebase project whose sign-in tokens the API accepts. Mentors are only recognised when it is set.
# On a live server set it last: SENSEI_SCOPE_DATA=1 first, then deploy, then this and the mentor
# list in one update. With scoping off it puts every call behind a sign-in, so guests get 401.
SENSEI_AUTH_PROJECT=

# --- Linkup (web search) ---
LINKUP_API_KEY=

# --- ElevenLabs (voice agent). Server side only: never put this in a VITE_ variable. ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Exa (web search in the CV studio). Optional: without it that search reports "not set up". ---
EXA_API_KEY=
